@model mvcproject.ViewModels.ProductListViewModel
@{
    ViewBag.Title = "Best Farm Products";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">Best Farm Products</h2>

    <form method="get" class="d-flex justify-content-center align-items-center flex-wrap gap-2 mb-4">
        <button type="submit" name="categoryFilter" value="Vegetables" class="btn btn-outline-success @(Model.CategoryFilter == "vegetables" ? "active" : "")">Vegetables</button>
        <button type="submit" name="categoryFilter" value="Fruits" class="btn btn-outline-warning @(Model.CategoryFilter == "fruits" ? "active" : "")">Fruits</button>
        <button type="submit" name="categoryFilter" value="Herbs" class="btn btn-outline-secondary @(Model.CategoryFilter == "herbs" ? "active" : "")">Herbs</button>
        <input type="text" name="search" value="@Model.Search" placeholder="Search by name..." class="form-control w-25" />
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-3 gx-0 gy-2">
    @foreach (var product in Model.Products)
    {
        <div class="col">
            <div class="card product-card text-center">
                <img src="~/images/@product.ImagePath" class="card-img-top product-img" />
                <div class="card-body">
                    <h5 class="card-title fw-bold custom-green">@product.Name</h5>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="text-primary fw-semibold">EGP @product.Price</span>
                        <span class="text-warning">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt"></i>
                            <i class="far fa-star"></i>
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between">
                    <button class="btn btn-custom-green w-75"><i class="fas fa-cart-plus"></i> Add to Cart</button>
                    <button class="btn btn-outline-danger"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
    }
</div>

<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" href="?page=@i&categoryFilter=@Model.CategoryFilter&search=@Model.Search">@i</a>
            </li>
        }
    </ul>
</nav>
