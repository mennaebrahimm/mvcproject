<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ecolive Navigation</title>
    <title>@ViewData["Title"] - Ecolive</title>
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/product.css" />

</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="#" class="logo">Ecoland</a>

            <div class="contact-info">
                <svg class="phone-icon" viewBox="0 0 24 24">
                    <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
                </svg>
                1-800-234-5678
            </div>

            <div class="search-container">
                <input type="text" class="search-input" placeholder="Search products..." />
                <button class="search-btn">
                    <svg class="search-icon" viewBox="0 0 24 24">
                        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    </svg>
                </button>
            </div>

            <div class="navbar-right">
                <a href="#" class="user-section">
                    <svg class="user-icon" viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    </svg>
                  
                </a>

               

                <button class="icon-btn">
                    <svg class="cart-icon" viewBox="0 0 24 24">
                        <path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03L21.7 4H5.21l-.94-2H1zm16 16c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                    </svg>
                    <span class="badge">4</span>
                </button>
            </div>
        </div>
    </nav>


    <header>
        <nav class="main-navbar">
            <div class="left-nav">
                <button class="btn-categories">All Categories</button>
                <ul class="nav-links">
                    <li><a href="/">Home</a></li>
                    <li class="dropdown">
                        <a href="/Product/Index">Products </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li><a href="/Account/SignOut">Sign Out</a></li>
                    }
                    else
                    {
                        <li class="dropdown">
                            <a href="/Account/Login">Login</a>
                        </li>
                        <li><a href="/Account/Register">Register</a></li>
                    }
                </ul>
            </div>
            <div class="right-nav">
                <span class="shipping-msg">
                    <i class="fa-solid fa-car-side"></i>
                    We ship to all Egypt & regions .
                </span>
            </div>
        </nav>
    </header>


    @await RenderSectionAsync("Scripts", required: false)

    <main>
        @RenderBody()
    </main>



    <footer class="footer-custom">
        <div class="container">
            <div class="footer-content">
                <div class="footer-col about">
                    <h3>EcoLand</h3>
                    <p>Morbi vehicula luctus feugiat. In sapien id odio tempor iaculis.</p>
                    <p><i class="fas fa-phone-alt"></i> +966 2254 344</p>
                    <p><i class="fas fa-envelope"></i> info@Ecloand.com</p>
                </div>

                <div class="footer-col links">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="#">Home</a></li>
                        <li><a href="#">Services</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>

                <div class="footer-col newsletter">
                    <h4>Join Our News</h4>
                    <p>Stay updated with our latest offers.</p>
                    <div class="join-news-box">
                        <input type="email" placeholder="Your Email">
                        <button><i class="fas fa-paper-plane"></i></button>
                    </div>
                    <div class="social-icons">
                        <i class="fab fa-facebook-f"></i>
                        <i class="fab fa-instagram"></i>
                        <i class="fab fa-linkedin-in"></i>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2025 <span>Ecoland</span> - All Rights Reserved.</p>
            </div>
        </div>
    </footer>


</body>
</html>
